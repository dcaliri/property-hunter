# Property Hunter configuration.
# Copy to .env and fill in real values. No secrets should ever be committed.

# --- Scope ---
# Search scope: operation-type-region slug as published by inmoup.com.ar
# e.g. departamentos-en-venta-en-capital-federal, departamentos-en-renta-en-capital-federal
SCOPE_OPERATION=venta
SCOPE_TYPE=departamentos
SCOPE_REGION=capital-federal
MAX_PAGES_PER_SEARCH=400

# --- Collection politeness ---
COLLECT_DELAY_SECONDS=2.0
COLLECT_TIMEOUT_SECONDS=30
COLLECT_MAX_RETRIES=3
USER_AGENT=property-hunter/0.1 (personal investment research; contact: your-email@example.com)

# --- Database ---
DB_PATH=data/property_hunter.db

# --- Baselines ---
MIN_OBSERVATIONS_PER_ZONE=5
BASELINE_WINDOW_DAYS=90

# --- Opportunity rules ---
UNDERVALUATION_THRESHOLD=0.10
YIELD_THRESHOLD=0.06
PRICE_DROP_THRESHOLD=0.05
PRICE_DROP_LOOKBACK_DAYS=30
# Rule switches (true/false)
UNDERVALUATION_ENABLED=true
YIELD_ENABLED=true
PRICE_DROP_ENABLED=true

# --- ML valuation model ---
ML_MIN_TRAIN_SAMPLES=200
ML_TEST_SPLIT=0.2

# --- SMTP (notification) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=
# Delivery retries
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_RETRY_BACKOFF_BASE_SECONDS=1.0

# --- Optional LLM (OpenAI-compatible chat endpoint) ---
# When LLM_API_KEY is unset, LLM features are skipped gracefully.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# --- Scheduling ---
SCHEDULE_DAILY_HOUR=9
SCHEDULE_DAILY_MINUTE=0
