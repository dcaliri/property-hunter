# Property Hunter — cloud deployment configuration.
#
# Copy to .env (or push via ./scripts/cloud/secrets.sh push) and fill in real
# values. Never commit real secrets: this file is documentation only and is
# git-ignored like every other .env.* variant.
#
# Only the keys relevant to a cloud run are listed here. Everything that is
# absent falls back to the app defaults (see .env.example / config.py).

# --- Scope ---
SCOPE_OPERATION=venta
SCOPE_TYPE=departamentos
SCOPE_REGION=capital-federal
MAX_PAGES_PER_SEARCH=400

# --- Collection politeness (keep production paths at or above defaults) ---
COLLECT_DELAY_SECONDS=2.0
COLLECT_TIMEOUT_SECONDS=30
COLLECT_MAX_RETRIES=3
USER_AGENT=property-hunter/0.1 (personal investment research; contact: your-email@example.com)

# --- Database (mounted EBS volume; must stay under /app/data in the image) ---
DB_PATH=/app/data/property_hunter.db

# --- Scheduler (UTC; the daily run happens on the cloud instance) ---
SCHEDULE_DAILY_HOUR=9
SCHEDULE_DAILY_MINUTE=0

# --- Dashboard internet exposure (Caddy reverse proxy + Basic Auth) ---
# UI_BASIC_AUTH_HASH is a bcrypt hash of the password. Generate one with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'the-password'
# The Caddyfile serves the dashboard at property-hunter.diegocaliri.com.ar.
UI_BASIC_AUTH_USER=admin
UI_BASIC_AUTH_HASH=

# --- SMTP (notification digests). Leave SMTP_HOST empty to skip real mail. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=

# --- Optional LLM (OpenAI-compatible endpoint); activate only if all set ---
# Production runs DeepSeek v4-flash (JSON mode) for structured feature extraction.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# --- ML valuation model ---
ML_MIN_TRAIN_SAMPLES=200
ML_TEST_SPLIT=0.2
